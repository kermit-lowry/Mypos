DATABASE_URL=postgresql://pos:pos@localhost:5432/mypos
JWT_SECRET=change-me
PORT=4000

CURRENCY=USD

# In-store card readers: Handpoint Cloud API on PAX terminals (blank = mock terminal)
HANDPOINT_API_KEY=
# development -> cloud.handpoint.io, production -> cloud.handpoint.com
HANDPOINT_ENV=development

# Online card payments (web store): mock | nmi | authorizenet
PAYMENT_GATEWAY=mock
NMI_SECURITY_KEY=
AUTHNET_API_LOGIN_ID=
AUTHNET_TRANSACTION_KEY=
AUTHNET_SANDBOX=true

# Price feeds. PRICE_REFRESH_HOURS=24 pulls market prices daily (needed for 7-day trends).
PRICE_REFRESH_HOURS=
POKEMONTCG_API_KEY=

# Channels (leave blank to disable)
SHOPIFY_SHOP=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_LOCATION_ID=
TCGPLAYER_ACCESS_TOKEN=
TCGPLAYER_STORE_KEY=
EBAY_ACCESS_TOKEN=
