// MyPOS data model. All money is integer cents.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Stores & staff ──────────────────────────────────────────────

model Location {
  id         String   @id @default(cuid())
  name       String
  /// Sales tax rate in basis points (8.25% = 825).
  taxRateBps Int      @default(0)
  timezone   String   @default("America/New_York")
  /// Dual pricing: card price = cash price + this many bps (399 = 3.99%). 0 = off.
  cardPriceBps Int    @default(0)
  /// Tenders besides CARD that pay the card price (GIFT_CARD, STORE_CREDIT,
  /// CHECK, LOYALTY). Empty = they all pay the cash price.
  cardPricedTenders String[] @default([])
  /// Zebra (ZPL) label printer on the store network, "host" or "host:port".
  labelPrinterHost String?
  /// Shown on receipts.
  receiptHeader String?
  receiptFooter String?
  createdAt  DateTime @default(now())

  active     Boolean  @default(true)
  address    String?
  phone      String?

  /// Cash must go into an open drawer session (shift); off = cash sales work without one.
  requireDrawerSession Boolean @default(false)
  /// Closing count is blind: the expected amount is hidden until the count is entered.
  blindCashCount Boolean @default(true)
  /// A closing variance beyond this needs a manager's approval (cents).
  cashVarianceAlertCents Int @default(500)

  drawerSessions DrawerSession[]
  timeEntries    TimeEntry[]
  inventory   InventoryLevel[]
  movements   InventoryMovement[]
  orders      Order[]
  buylists    BuylistTicket[]
  events      Event[]
  terminals   Terminal[]
  consignment ConsignmentItem[]
  purchaseOrders PurchaseOrder[]
  transfersOut   Transfer[] @relation("TransferFrom")
  transfersIn    Transfer[] @relation("TransferTo")
}

model Staff {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  /// bcrypt hash of the register PIN.
  pinHash   String
  /// bcrypt hash of the back-office website password (register uses the PIN).
  passwordHash String?
  /// HMAC of the PIN (server secret), so a PIN alone finds its employee for
  /// PIN sign-in and manager approvals. Makes PINs unique per store.
  pinLookup String?   @unique
  role      StaffRole @default(CASHIER)
  active    Boolean   @default(true)
  /// Per-employee permission overrides: { REFUND: "ALLOW", ... }.
  permissionOverrides Json @default("{}")
  /// Per-employee discount limit (bps of a line) without approval; null = role's.
  discountMaxBps Int?
  createdAt DateTime  @default(now())

  orders    Order[]
  buylists  BuylistTicket[]
  movements InventoryMovement[]
  auths     Authentication[]
  drawersOpened DrawerSession[] @relation("DrawerOpenedBy")
  drawersClosed DrawerSession[] @relation("DrawerClosedBy")
  cashMovements CashMovement[]
  timeEntries   TimeEntry[]
}

enum StaffRole {
  OWNER
  MANAGER
  CASHIER
}

/// A card-present payment device registered with the merchant gateway.
model Terminal {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  name       String
  /// Device identifier on the processor (Handpoint: serial_number).
  gatewayRef String   @unique
  /// Device model (Handpoint: terminal_type, e.g. PAXA920PRO).
  model      String?
  active     Boolean  @default(true)
  /// ESC/POS receipt printer at this register, "host" or "host:port" (raw TCP 9100).
  /// A cash drawer plugged into the printer opens through it.
  receiptPrinterHost String?
  createdAt  DateTime @default(now())
}

// ─── Customers & store credit ────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  phone     String?
  /// Game → player id, e.g. {"pokemon": "1234567", "yugioh": "0000123456"}.
  playerIds Json     @default("{}")
  createdAt DateTime @default(now())

  creditEntries  StoreCreditEntry[]
  orders         Order[]
  buylists       BuylistTicket[]
  registrations  EventRegistration[]
  preorders      Preorder[]
  consignor      Consignor?
  loyalty        LoyaltyEntry[]
}

/// Append-only ledger. Balance = SUM(amountCents). Never update rows.
model StoreCreditEntry {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  amountCents Int
  reason      String
  orderId     String?
  buylistId   String?
  createdAt   DateTime @default(now())

  @@index([customerId])
}

model GiftCard {
  id           String   @id @default(cuid())
  code         String   @unique
  balanceCents Int
  createdAt    DateTime @default(now())
}

// ─── Catalog ─────────────────────────────────────────────────────

enum ProductKind {
  TCG_SINGLE
  TCG_SEALED
  SNEAKER
  APPAREL
  COLLECTIBLE
  ACCESSORY
  EVENT_ENTRY
}

enum SalesChannel {
  POS
  STOREFRONT
  SHOPIFY
  TCGPLAYER
  EBAY
}

/// A brand (Nike, Supreme, Pokémon…). Products link to one; `Product.brand`
/// carries the same name for display and search.
model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  products  Product[]
}

/// A vendor that supplies a product, with their item number and price. A
/// product can have several; the preferred one drives reorder suggestions.
model ProductVendor {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  /// The vendor's own item / style number.
  vendorSku String?
  /// What this vendor charges per unit, if known (updated by receipts).
  costCents Int?
  preferred Boolean  @default(false)
  leadDays  Int?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, vendorId])
  @@index([vendorId])
}

model Product {
  id          String         @id @default(cuid())
  kind        ProductKind
  title       String
  /// Brand name (kept equal to `brandRef.name` when linked).
  brand       String?
  brandId     String?
  brandRef    Brand?         @relation(fields: [brandId], references: [id])
  vendors     ProductVendor[]
  description String?
  imageUrl    String?
  channels    SalesChannel[] @default([POS])

  // TCG metadata
  game            String?
  setCode         String?
  setName         String?
  collectorNumber String?
  rarity          String?
  scryfallId      String?
  tcgplayerId     String?
  pokemonTcgId    String?

  // Sneaker / apparel metadata
  styleCode String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  variants  Variant[]

  @@index([kind])
  @@index([categoryId])
  @@index([brandId])
  @@index([game, setCode])
  @@index([title])
}

enum CardCondition {
  NM
  LP
  MP
  HP
  DMG
}

enum CardFinish {
  NONFOIL
  FOIL
  ETCHED
  REVERSE_HOLO
  HOLO
}

enum GradingCompany {
  PSA
  BGS
  CGC
  SGC
  TAG
  ACE
  OTHER
}

enum ItemCondition {
  DS
  VNDS
  USED
  DAMAGED
}

model Variant {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String  @unique
  barcode    String? @unique
  priceCents Int
  costCents  Int?
  taxable    Boolean @default(true)

  /// Raw (ungraded) card condition.
  condition CardCondition?
  finish    CardFinish?
  language  String?

  /// Photo of this exact item (a used pair, a specific slab); falls back to the product's.
  imageUrl String?

  /// Graded (slabbed) card. A graded variant is a one-of-one identified by its cert.
  gradingCompany GradingCompany?
  /// As printed on the slab: "10", "9.5", "Black Label 10", "Pristine 10".
  grade          String?
  certNumber     String?

  size          String?
  colorway      String?
  itemCondition ItemCondition?
  /// One-of-one item (e.g. a specific consigned pair); quantity never exceeds 1.
  serialized    Boolean        @default(false)

  /// Last market price pulled from a price feed.
  marketCents    Int?
  marketSource   String?
  marketAt       DateTime?
  /// Reprice automatically when the feed changes.
  autoPrice      Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gradingCompany, certNumber])

  inventory      InventoryLevel[]
  movements      InventoryMovement[]
  orderLines     OrderLine[]
  priceHistory   PricePoint[]
  purchaseLines  PurchaseOrderLine[]
  transferLines  TransferLine[]
  authentication Authentication[]
  consignment    ConsignmentItem[]
  preorder       PreorderProduct?
  channelLinks   ChannelListing[]
}

model PricePoint {
  id          String   @id @default(cuid())
  variantId   String
  variant     Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  source      String
  marketCents Int
  capturedAt  DateTime @default(now())

  @@index([variantId, capturedAt])
}

// ─── Inventory ───────────────────────────────────────────────────

model InventoryLevel {
  variantId  String
  variant    Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  onHand     Int      @default(0)
  /// Held for unpaid online carts / preorders.
  reserved   Int      @default(0)
  /// Reorder when on hand drops to this; null = don't flag.
  lowStockQty Int?
  updatedAt  DateTime @updatedAt

  @@id([variantId, locationId])
}

enum MovementReason {
  RECEIVE
  SALE
  REFUND
  BUYLIST
  CONSIGN_IN
  CONSIGN_OUT
  COUNT
  DAMAGE
  THEFT
  TRANSFER
  OTHER
}

// ─── Purchasing & transfers ──────────────────────────────────────

model Vendor {
  id        String   @id @default(cuid())
  name      String   @unique
  email     String?
  phone     String?
  notes     String?
  active    Boolean  @default(true)
  accountNumber     String?
  contactName       String?
  website           String?
  address           String?
  /// New items from this vendor default to this category.
  defaultCategoryId String?
  createdAt DateTime @default(now())

  purchaseOrders PurchaseOrder[]
  products       ProductVendor[]
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  number     Int                 @unique @default(autoincrement())
  status     PurchaseOrderStatus @default(DRAFT)
  vendorId   String
  vendor     Vendor              @relation(fields: [vendorId], references: [id])
  locationId String
  location   Location            @relation(fields: [locationId], references: [id])
  reference  String?
  notes      String?
  expectedAt DateTime?
  orderedAt  DateTime?
  receivedAt DateTime?
  shippingCents Int              @default(0)
  createdById String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  lines    PurchaseOrderLine[]
  receipts PurchaseReceipt[]
}

/// One delivery against a purchase order (an order can arrive in several).
model PurchaseReceipt {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  /// Packing slip / invoice number for this delivery.
  reference       String?
  staffId         String?
  receivedAt      DateTime      @default(now())

  lines PurchaseReceiptLine[]
}

model PurchaseReceiptLine {
  id            String          @id @default(cuid())
  receiptId     String
  receipt       PurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  variantId     String
  quantity      Int
  /// What was actually paid per unit on this delivery.
  unitCostCents Int
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variantId       String
  variant         Variant       @relation(fields: [variantId], references: [id])
  quantity        Int
  receivedQty     Int           @default(0)
  unitCostCents   Int

  @@unique([purchaseOrderId, variantId])
}

enum TransferStatus {
  DRAFT
  SENT
  RECEIVED
  CANCELLED
}

/// Stock moving between locations. Sending takes it out of the source;
/// receiving puts it into the destination (in between it's "in transit").
model Transfer {
  id             String         @id @default(cuid())
  number         Int            @unique @default(autoincrement())
  status         TransferStatus @default(DRAFT)
  fromLocationId String
  fromLocation   Location       @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocationId   String
  toLocation     Location       @relation("TransferTo", fields: [toLocationId], references: [id])
  reference      String?
  notes          String?
  expectedAt     DateTime?
  sentAt         DateTime?
  receivedAt     DateTime?
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  lines TransferLine[]
}

model TransferLine {
  id          String   @id @default(cuid())
  transferId  String
  transfer    Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variantId   String
  variant     Variant  @relation(fields: [variantId], references: [id])
  quantity    Int
  receivedQty Int      @default(0)

  @@unique([transferId, variantId])
}

/// Append-only audit trail for every inventory change.
model InventoryMovement {
  id         String         @id @default(cuid())
  variantId  String
  variant    Variant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  locationId String
  location   Location       @relation(fields: [locationId], references: [id])
  delta      Int
  reason     MovementReason
  note       String?
  orderId    String?
  buylistId  String?
  staffId    String?
  staff      Staff?         @relation(fields: [staffId], references: [id])
  createdAt  DateTime       @default(now())

  @@index([variantId, createdAt])
}

// ─── Orders & payments ───────────────────────────────────────────

enum OrderStatus {
  OPEN
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  VOID
}

model Order {
  id             String       @id @default(cuid())
  number         Int          @unique @default(autoincrement())
  channel        SalesChannel @default(POS)
  /// Order id on the external channel (Shopify order id, TCGplayer order #, ...).
  externalId     String?
  status         OrderStatus  @default(OPEN)
  locationId     String
  location       Location     @relation(fields: [locationId], references: [id])
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id])
  staffId        String?
  staff          Staff?       @relation(fields: [staffId], references: [id])
  idempotencyKey String?      @unique
  subtotalCents  Int
  discountCents  Int
  taxCents       Int
  totalCents     Int
  note           String?
  /// Dual pricing: what card payments added over the cash total (totalCents is
  /// the cash-price total), and the sales tax included in that amount.
  cardAdjustmentCents    Int @default(0)
  cardAdjustmentTaxCents Int @default(0)
  /// Card markup in effect when the sale was made, and what paying fully by card cost.
  cardPriceBps           Int @default(0)
  cardTotalCents         Int @default(0)
  /// Loyalty earned on this sale, in the program's unit at the time.
  loyaltyEarned   Int          @default(0)
  loyaltyUnit     LoyaltyUnit?
  /// Spend that earned, used to claw back proportionally on refunds.
  loyaltyEligibleCents Int     @default(0)
  pointsRedeemed  Int          @default(0)
  /// Deals applied: [{ promotionId, name, discountCents }].
  appliedPromotions Json       @default("[]")
  createdAt      DateTime     @default(now())

  lines    OrderLine[]
  payments Payment[]

  @@unique([channel, externalId])
  @@index([createdAt])
}

model OrderLine {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId      String
  variant        Variant @relation(fields: [variantId], references: [id])
  title          String
  quantity       Int
  unitPriceCents Int
  /// Total discount, including rewardDiscountCents.
  discountCents  Int     @default(0)
  /// Portion of discountCents that came from loyalty rewards.
  rewardDiscountCents Int @default(0)
  /// Portion of discountCents that came from automated deals.
  promoDiscountCents  Int @default(0)
  /// Why a manual discount was given (snapshot of the reason's name).
  discountReasonId String?
  discountReason   String?
  discountNote     String?
  /// Whether this line counted toward loyalty earning.
  earnsLoyalty   Boolean @default(false)
  /// Unit cost when sold (for profit reports).
  costCents      Int?
  taxable        Boolean
  refundedQty    Int     @default(0)
  /// Set when the line sold a consigned unit.
  consignmentItemId String?

  eventRegistration EventRegistration?
}

enum PaymentStatus {
  PENDING
  APPROVED
  DECLINED
  VOIDED
  REFUNDED
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String?
  order       Order?        @relation(fields: [orderId], references: [id])
  preorderId  String?
  preorder    Preorder?     @relation(fields: [preorderId], references: [id])
  /// Positive = money in, negative = refund out.
  amountCents Int
  tender      String
  status      PaymentStatus
  gateway     String?
  /// Gateway transaction id.
  gatewayRef  String?
  cardBrand   String?
  cardLast4   String?
  /// For cash: change handed back.
  changeCents Int?
  /// Card-present terminal the payment ran on.
  terminalId  String?
  /// Cash drawer session (shift) this payment's cash went into or came out of.
  drawerSessionId String?
  drawerSession   DrawerSession? @relation(fields: [drawerSessionId], references: [id])
  /// Set on refund rows: the original payment being refunded.
  refundOfId  String?
  raw         Json?
  createdAt   DateTime      @default(now())
}

// ─── Buylist / trade-ins ─────────────────────────────────────────

enum BuylistStatus {
  QUOTED
  ACCEPTED
  REJECTED
}

enum BuylistPayout {
  CASH
  STORE_CREDIT
}

model BuylistTicket {
  id               String         @id @default(cuid())
  number           Int            @unique @default(autoincrement())
  status           BuylistStatus  @default(QUOTED)
  locationId       String
  location         Location       @relation(fields: [locationId], references: [id])
  customerId       String?
  customer         Customer?      @relation(fields: [customerId], references: [id])
  staffId          String?
  staff            Staff?         @relation(fields: [staffId], references: [id])
  payout           BuylistPayout?
  cashTotalCents   Int
  creditTotalCents Int
  paidCents        Int?
  sellerIdType     String?
  sellerIdLast4    String?
  /// Drawer session a cash payout came out of.
  drawerSessionId  String?
  drawerSession    DrawerSession? @relation(fields: [drawerSessionId], references: [id])
  createdAt        DateTime       @default(now())
  acceptedAt       DateTime?

  lines BuylistLine[]
}

model BuylistLine {
  id               String        @id @default(cuid())
  ticketId         String
  ticket           BuylistTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  variantId        String?
  description      String
  quantity         Int
  marketCents      Int
  cashOfferCents   Int
  creditOfferCents Int
  /// What the store's rules suggested, kept next to what was offered.
  suggestedCashCents   Int?
  suggestedCreditCents Int?
  /// Why: "Resells for about $100.00 (market price)", ...
  offerNotes           String[] @default([])
}

// ─── Consignment & authentication (sneakers / streetwear) ────────

model Consignor {
  id            String   @id @default(cuid())
  customerId    String   @unique
  customer      Customer @relation(fields: [customerId], references: [id])
  /// Store's cut of each sale, in bps.
  commissionBps Int
  createdAt     DateTime @default(now())

  items   ConsignmentItem[]
  payouts ConsignmentPayout[]
}

enum ConsignmentStatus {
  ACTIVE
  SOLD
  RETURNED
}

model ConsignmentItem {
  id          String            @id @default(cuid())
  consignorId String
  consignor   Consignor         @relation(fields: [consignorId], references: [id])
  variantId   String
  variant     Variant           @relation(fields: [variantId], references: [id])
  locationId  String
  location    Location          @relation(fields: [locationId], references: [id])
  quantity    Int
  soldQty     Int               @default(0)
  floorCents  Int?
  status      ConsignmentStatus @default(ACTIVE)
  createdAt   DateTime          @default(now())

  payouts ConsignmentPayout[]
}

enum PayoutStatus {
  OWED
  PAID
}

model ConsignmentPayout {
  id                String          @id @default(cuid())
  consignorId       String
  consignor         Consignor       @relation(fields: [consignorId], references: [id])
  consignmentItemId String
  consignmentItem   ConsignmentItem @relation(fields: [consignmentItemId], references: [id])
  orderLineId       String
  saleCents         Int
  commissionCents   Int
  payoutCents       Int
  status            PayoutStatus    @default(OWED)
  paidAt            DateTime?
  createdAt         DateTime        @default(now())
}

enum AuthResult {
  PASS
  FAIL
  INCONCLUSIVE
}

model Authentication {
  id        String     @id @default(cuid())
  variantId String
  variant   Variant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  staffId   String?
  staff     Staff?     @relation(fields: [staffId], references: [id])
  result    AuthResult
  method    String
  notes     String?
  photoUrls String[]
  createdAt DateTime   @default(now())
}

// ─── Events & preorders ──────────────────────────────────────────

model Event {
  id            String   @id @default(cuid())
  locationId    String
  location      Location @relation(fields: [locationId], references: [id])
  name          String
  game          String?
  format        String?
  startsAt      DateTime
  capacity      Int
  entryFeeCents Int
  /// EVENT_ENTRY variant sold at checkout to register a player.
  variantId     String   @unique
  createdAt     DateTime @default(now())

  registrations EventRegistration[]
}

model EventRegistration {
  id          String     @id @default(cuid())
  eventId     String
  event       Event      @relation(fields: [eventId], references: [id])
  customerId  String
  customer    Customer   @relation(fields: [customerId], references: [id])
  orderLineId String?    @unique
  orderLine   OrderLine? @relation(fields: [orderLineId], references: [id])
  checkedIn   Boolean    @default(false)
  createdAt   DateTime   @default(now())

  @@unique([eventId, customerId])
}

model PreorderProduct {
  id               String    @id @default(cuid())
  variantId        String    @unique
  variant          Variant   @relation(fields: [variantId], references: [id])
  releaseDate      DateTime
  allocation       Int?
  depositCents     Int
  perCustomerLimit Int?
  createdAt        DateTime  @default(now())

  preorders Preorder[]
}

enum PreorderStatus {
  RESERVED
  FULFILLED
  CANCELLED
}

model Preorder {
  id                String          @id @default(cuid())
  preorderProductId String
  preorderProduct   PreorderProduct @relation(fields: [preorderProductId], references: [id])
  customerId        String
  customer          Customer        @relation(fields: [customerId], references: [id])
  locationId        String
  quantity          Int
  depositPaidCents  Int
  status            PreorderStatus  @default(RESERVED)
  idempotencyKey    String          @unique
  /// Order created when the preorder is picked up / shipped.
  fulfilledOrderId  String?
  createdAt         DateTime        @default(now())

  payments Payment[]
}

// ─── External sales channels ─────────────────────────────────────

/// Links a variant to its listing on an external channel.
model ChannelListing {
  id          String       @id @default(cuid())
  variantId   String
  variant     Variant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  channel     SalesChannel
  externalId  String
  /// Secondary id some channels need (e.g. Shopify inventory_item_id).
  inventoryRef String?
  /// Last quantity pushed, so sync only sends changes.
  lastPushed  Int?
  lastSyncAt  DateTime?
  lastError   String?

  @@unique([variantId, channel])
  @@unique([channel, externalId])
}

model ChannelSyncCursor {
  channel   SalesChannel @id
  /// Opaque cursor / timestamp for incremental order pulls.
  cursor    String?
  updatedAt DateTime     @updatedAt
}

// ─── Loyalty ─────────────────────────────────────────────────────

enum LoyaltyType {
  CASHBACK
  POINTS
}

enum LoyaltyUnit {
  /// Rewards dollars (CASHBACK programs), in cents.
  CENTS
  POINTS
}

/// Owner-configured program. One row, id "default".
model LoyaltyProgram {
  id              String        @id @default("default")
  enabled         Boolean       @default(false)
  type            LoyaltyType   @default(POINTS)
  cashbackBps     Int           @default(0)
  pointsPerDollar Int           @default(1)
  excludedKinds   ProductKind[] @default([])
  earnOnCredit    Boolean       @default(false)
  updatedAt       DateTime      @updatedAt
}

enum RewardType {
  PERCENT_OFF
  AMOUNT_OFF
  ITEM
}

/// A points reward the owner offers, e.g. "500 pts = 10% off", "200 pts = free booster".
model LoyaltyReward {
  id               String     @id @default(cuid())
  name             String
  type             RewardType
  pointsCost       Int
  percentBps       Int?
  amountCents      Int?
  maxDiscountCents Int?
  variantId        String?
  productId        String?
  active           Boolean    @default(true)
  createdAt        DateTime   @default(now())
}

/// Append-only ledger. Balance per unit = SUM(amount).
model LoyaltyEntry {
  id         String      @id @default(cuid())
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id])
  unit       LoyaltyUnit
  amount     Int
  reason     String
  orderId    String?
  rewardId   String?
  createdAt  DateTime    @default(now())

  @@index([customerId, unit])
}

/// Latest cart shown on a customer-facing display, keyed by the register's channel.
model CustomerDisplay {
  channel   String   @id
  payload   Json
  updatedAt DateTime @updatedAt
}

// ─── Categories & automated deals ────────────────────────────────

/// Category tree, e.g. Pokémon > Sealed > Booster Boxes. Deals on a category
/// cover everything beneath it.
model Category {
  id        String     @id @default(cuid())
  name      String
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
  createdAt DateTime   @default(now())

  @@unique([parentId, name])
}

enum PromotionType {
  PERCENT_OFF
  AMOUNT_OFF
  SALE_PRICE
  BUY_X_GET_Y
  MULTI_BUY
  ORDER_DISCOUNT
}

/// Automated discount rule. See packages/shared/src/promotions.ts for semantics.
model Promotion {
  id          String        @id @default(cuid())
  name        String
  description String?
  active      Boolean       @default(true)
  type        PromotionType
  priority    Int           @default(100)
  stackable   Boolean       @default(false)

  // What it applies to
  targetAll          Boolean  @default(false)
  productIds         String[] @default([])
  variantIds         String[] @default([])
  categoryIds        String[] @default([])
  excludeProductIds  String[] @default([])
  excludeCategoryIds String[] @default([])
  /// BUY_X_GET_Y "get" items; all empty = same as the targets above.
  getProductIds      String[] @default([])
  getVariantIds      String[] @default([])
  getCategoryIds     String[] @default([])

  // Amounts
  percentBps       Int?
  amountCents      Int?
  priceCents       Int?
  buyQty           Int?
  getQty           Int?
  getDiscountBps   Int?
  minQty           Int?
  minSubtotalCents Int?
  maxApplications  Int?

  // When
  startsAt   DateTime?
  endsAt     DateTime?
  /// Local calendar dates "YYYY-MM-DD".
  dates      String[]  @default([])
  /// 0 = Sunday.
  daysOfWeek Int[]     @default([])
  /// Local "HH:MM".
  startTime  String?
  endTime    String?

  // Where
  channels    SalesChannel[] @default([POS, STOREFRONT])
  /// Empty = every location.
  locationIds String[]       @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Permissions, approvals, audit ───────────────────────────────

/// Store's settings for a role (owners always have everything).
model RolePolicy {
  role           StaffRole @id
  /// { PERMISSION: "ALLOW" | "PIN" | "DENY" }; missing = built-in default.
  permissions    Json      @default("{}")
  discountMaxBps Int
  updatedAt      DateTime  @updatedAt
}

/// A manager's PIN approval for something an employee can't do alone.
/// The token is the id: random, single use, short-lived.
model ApprovalGrant {
  id             String    @id
  approverId     String
  requesterId    String
  permissions    String[]
  /// Most this grant may discount (bps of a line): the amount the approval
  /// was asked for, capped at the approver's own limit. Not a blank cheque
  /// for the approver's whole limit.
  discountMaxBps Int
  reason         String?
  expiresAt      DateTime
  usedAt         DateTime?
  usedFor        String?
  createdAt      DateTime  @default(now())

  @@index([requesterId, createdAt])
}

/// Who did what at the register: voids, cart deletes, no-sales, approvals.
model AuditEvent {
  id         String   @id @default(cuid())
  action     String
  staffId    String?
  approverId String?
  locationId String?
  details    Json     @default("{}")
  /// HTTP status for logged requests (403s show denied attempts).
  status     Int?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
  @@index([staffId, createdAt])
}

// ─── Manual discount setup ───────────────────────────────────────

/// Reasons a cashier must pick when giving a manual discount.
model DiscountReason {
  id           String   @id @default(cuid())
  name         String   @unique
  /// Make the cashier type a note too (e.g. "Price match" -> which store).
  requiresNote Boolean  @default(false)
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
}

enum DiscountKind {
  PERCENT
  AMOUNT
}

/// One-tap discount buttons at the register.
model DiscountPreset {
  id        String       @id @default(cuid())
  label     String
  kind      DiscountKind
  /// bps for PERCENT (1000 = 10%), cents for AMOUNT.
  value     Int
  /// Reason filled in automatically when the button is used.
  reasonId  String?
  active    Boolean      @default(true)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
}

/// Trade-in offer rules. No kind/category = store default; a category rule
/// beats a product-type rule, which beats the default.
model BuylistPolicy {
  id              String       @id @default(cuid())
  kind            ProductKind?
  categoryId      String?
  cashMarginBps   Int
  creditBonusBps  Int
  trendWeightBps  Int
  maxTrendUpBps   Int
  overstockQty    Int?
  overstockCutBps Int          @default(2000)
  minResaleCents  Int          @default(100)
  updatedAt       DateTime     @updatedAt

  @@unique([kind, categoryId])
}

// ─── Cash drawer sessions (shifts) and the time clock ────────────

enum DrawerSessionStatus {
  OPEN
  CLOSED
}

/// One cash drawer from "start shift" (float counted in) to "close" (blind
/// count, variance, closing report). Belongs to a register (its terminal) or,
/// with no terminal, to the location's single drawer.
model DrawerSession {
  id         String              @id @default(cuid())
  number     Int                 @unique @default(autoincrement())
  status     DrawerSessionStatus @default(OPEN)
  locationId String
  location   Location            @relation(fields: [locationId], references: [id])
  /// The register this drawer belongs to; null = the location's only drawer.
  terminalId String?
  openedById String?
  openedBy   Staff?              @relation("DrawerOpenedBy", fields: [openedById], references: [id])
  openedAt   DateTime            @default(now())
  /// Starting cash counted in.
  openingFloatCents Int          @default(0)
  /// Denomination counts at open, e.g. { "2000": 5, "100": 20, "25": 40 } (cents → count).
  openingCount Json?
  closedById String?
  closedBy   Staff?              @relation("DrawerClosedBy", fields: [closedById], references: [id])
  closedAt   DateTime?
  /// Set at close.
  expectedCashCents Int?
  countedCashCents  Int?
  /// counted − expected (negative = short).
  varianceCents     Int?
  closingCount      Json?
  /// Manager who accepted a variance beyond the alert amount.
  approvedById      String?
  /// Snapshot of the closing (Z) report: sales, tenders, cash in/out, by employee.
  closingReport     Json?
  notes             String?

  payments  Payment[]
  buylists  BuylistTicket[]
  movements CashMovement[]

  @@index([locationId, status])
  @@index([terminalId, status])
  @@index([openedAt])
}

enum CashMovementKind {
  PAID_IN
  PAID_OUT
  DROP
}

/// Cash put in or taken out of a drawer besides sales: petty cash, a safe drop, change from the bank.
model CashMovement {
  id          String           @id @default(cuid())
  sessionId   String
  session     DrawerSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kind        CashMovementKind
  /// Always positive; the kind says which way it went.
  amountCents Int
  reason      String
  note        String?
  staffId     String?
  staff       Staff?           @relation(fields: [staffId], references: [id])
  approverId  String?
  createdAt   DateTime         @default(now())

  @@index([sessionId])
}

/// Time clock: one row per clock-in, closed by the clock-out.
model TimeEntry {
  id           String    @id @default(cuid())
  staffId      String
  staff        Staff     @relation(fields: [staffId], references: [id])
  locationId   String
  location     Location  @relation(fields: [locationId], references: [id])
  clockIn      DateTime  @default(now())
  clockOut     DateTime?
  breakMinutes Int       @default(0)
  note         String?
  /// "register" (PIN at the register), "web", or "edited" when a manager changed it.
  source       String    @default("register")
  editedById   String?
  editedAt     DateTime?
  createdAt    DateTime  @default(now())

  @@index([staffId, clockIn])
  @@index([locationId, clockIn])
}
